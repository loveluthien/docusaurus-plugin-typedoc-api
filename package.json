{
  "private": true,
  "name": "docusaurus-plugin-typedoc-api-root",
  "scripts": {
    "check": "npm run type && npm run lint",
    "clean": "node -e \"require('node:fs').rmSync('packages/plugin/lib', { recursive: true, force: true })\"",
    "docs": "npm run build && cd website && npm run start",
    "build": "npm run clean && cd packages/plugin && tsup && tsc --emitDeclarationOnly -p tsconfig.json --outDir lib && cp src/components/styles.css lib/components/styles.css",
    "pack": "npm run build && cd packages/plugin && npm pack",
    "format": "prettier --write .",
    "lint": "eslint --cache --color --fix packages/plugin/src website/src",
    "type": "tsc --build",
    "release": "npm run pack && npm run check && lerna-release"
  },
  "devDependencies": {
    "@moonrepo/dev": "^3.1.2",
    "@types/react": "^19.2.18",
    "eslint": "^10.8.1",
    "lerna": "^10.0.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "^2.1.2"
    },
    "nx": {
      "undici": "^7.29.1"
    },
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.0.5",
    "tsup": {
      "esbuild": "^0.28.1"
    },
    "uuid": "^11.1.1"
  },
  "workspaces": [
    "packages/*",
    "website"
  ],
  "packageManager": "npm@11.16.0"
}
