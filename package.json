{
  "private": true,
  "name": "docusaurus-plugin-typedoc-api-root",
  "scripts": {
    "check": "npm run type && npm run lint",
    "clean": "packemon clean --cwd packages/plugin",
    "docs": "npm run build && cd website && npm run start",
    "build": "packemon build --addEngines --cwd packages/plugin",
    "pack": "rimraf packages/plugin/tsconfig.lib.tsbuildinfo && packemon pack --addEngines --declaration --cwd packages/plugin && cd packages/plugin && npm pack",
    "format": "prettier --write .",
    "lint": "eslint --cache --color --fix packages/plugin/src website/src",
    "type": "tsc --build",
    "release": "npm run pack && npm run check && lerna-release"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@moonrepo/dev": "^3.1.2",
    "@types/marked": "^6.0.0",
    "@types/react": "^19.2.16",
    "eslint": "^9.14.0",
    "eslint-config-moon": "^4.0.4",
    "lerna": "^9.0.7",
    "packemon": "^4.1.2",
    "prettier": "^3.8.3",
    "prettier-config-moon": "^1.2.2",
    "react": "^19.2.7",
    "rimraf": "^6.1.3",
    "tsconfig-moon": "^1.4.2",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "packages/*",
    "website"
  ],
  "packageManager": "npm@11.16.0"
}
