{
  "name": "docusaurus-plugin-typedoc-api",
  "version": "4.5.0",
  "description": "Docusaurus plugin that provides source code API documentation powered by TypeDoc. ",
  "keywords": [
    "docusaurus",
    "plugin",
    "typedoc",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:loveluthien/docusaurus-plugin-typedoc-api.git"
  },
  "author": "Miles Johnson, Kuan-Chou Hou",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "assets/**/*",
    "lib/**/*",
    "src/**/*",
    "styles.css"
  ],
  "engines": {
    "node": ">=16.12.0"
  },
  "packemon": {
    "format": "lib",
    "platform": "node",
    "externals": [
      "@theme/*",
      "@docusaurus/*",
      "@vscode/*",
      "css$"
    ]
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/mdx-loader": "^3.9.2",
    "react": ">=18.0.0",
    "typescript": ">=5.0.0"
  },
  "dependencies": {
    "@docusaurus/plugin-content-docs": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "@docusaurus/utils": "^3.9.2",
    "@vscode/codicons": "^0.0.36",
    "marked": "^17.0.1",
    "marked-smartypants": "^1.1.5",
    "typedoc": "^0.28.15"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.3"
  }
}
